# Copy to .env and edit before running docker compose in production.

# 32+ bytes of high-entropy secret for signing user / agent / session JWTs.
REBELDESK_JWT_KEY=CHANGE-ME-to-a-random-48-byte-base64-secret

# Shared secret between the server (TurnCredentialService) and coturn (static-auth-secret
# in docker/coturn/turnserver.conf). Any 32+ bytes works.
REBELDESK_TURN_SECRET=CHANGE-ME-to-a-random-32-byte-base64-secret

# The hostname (or public IP) your STUN/TURN clients will reach.
TURN_HOSTNAME=turn.example.com

ASPNETCORE_ENVIRONMENT=Production
