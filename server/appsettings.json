{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Kestrel": {
    "Endpoints": {
      "Http": {
        "Url": "http://0.0.0.0:8080"
      }
    }
  },
  "Auth": {
    "Issuer": "rebeldesk",
    "Audience": "rebeldesk",
    "UserTokenMinutes": 480,
    "AgentTokenMinutes": 43200,
    "SessionTokenMinutes": 10
  },
  "Turn": {
    "Realm": "rebeldesk",
    "StunUris": ["stun:localhost:3478"],
    "TurnUris": ["turn:localhost:3478?transport=udp", "turn:localhost:3478?transport=tcp"],
    "TtlSeconds": 600
  },
  "Cors": {
    "Origins": ["http://localhost:5173", "http://localhost:4173"]
  },
  "Database": {
    "Path": "rebeldesk.db"
  }
}
